# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Batch files must use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
